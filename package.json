{
  "name": "saas-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Modular Multi-Tenant SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace=packages/database",
    "prisma:migrate": "npm run prisma:migrate --workspace=packages/database"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
